// Gunsmith3D - version information. GENERATED by CMake from src/core/version.hpp.in: edit the
// version in CMakeLists.txt (project VERSION and GUNSMITH_STAGE), not the generated copy.
#pragma once

#define GUNSMITH_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define GUNSMITH_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define GUNSMITH_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define GUNSMITH_STAGE "@GUNSMITH_STAGE@"            // dev, alpha, beta, rc, or "" for a release
#define GUNSMITH_VERSION "@GUNSMITH_VERSION@"        // e.g. 0.1.0-alpha
#define GUNSMITH_BUILD "@GUNSMITH_BUILD@"            // git commit when built from a checkout, else ""

// Blueprint file format. Bump when a change means older versions would load a design wrongly,
// and teach designFromJson to upgrade the older format.
#define GUNSMITH_BLUEPRINT_FORMAT 1

namespace version {
inline const char* text() { return GUNSMITH_VERSION; }
inline const char* full() { return sizeof(GUNSMITH_BUILD) > 1 ? GUNSMITH_VERSION " (" GUNSMITH_BUILD ")" : GUNSMITH_VERSION; }
}
