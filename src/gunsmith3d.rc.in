// Windows version resource. GENERATED values come from CMakeLists.txt.
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       @GUNSMITH_RC_FLAGS@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "OAB Foundry"
      VALUE "FileDescription", "Gunsmith3D - design and test firearm mechanisms"
      VALUE "LegalCopyright", "Copyright (C) 2026 The One Armed Bandit"
      VALUE "FileVersion", "@GUNSMITH_VERSION@"
      VALUE "ProductName", "Gunsmith3D"
      VALUE "ProductVersion", "@GUNSMITH_VERSION@"
      VALUE "InternalName", "gunsmith3d"
      VALUE "OriginalFilename", "gunsmith3d.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
